#!/bin/sh
set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
out="${TMPDIR:-/tmp}/lineage-js"

rm -rf "$out"
agda -i "$root" -l standard-library --js --js-optimize \
  --compile-dir="$out" "$root/Lineage/API/JavaScript.lagda.md"

cd "$root/web"
NODE_PATH="$out:$out/node_modules" pnpm exec tsx scripts/check-lineage-api.ts "$out"

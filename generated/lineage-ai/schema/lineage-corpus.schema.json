{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "accessibleDescription": {
          "type": "string"
        },
        "byteSize": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mediaType",
        "byteSize",
        "sha256",
        "path"
      ],
      "type": "object"
    },
    "ClozeTarget": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "minLength": 1,
          "type": "string"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "answer"
      ],
      "type": "object"
    },
    "EntityReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "fallback": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "requirement"
      ],
      "type": "object"
    },
    "InteroperabilityReport": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "losses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preservedArtifacts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "sourceFormat": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "exact",
            "lossy"
          ]
        },
        "targetFormat": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceFormat",
        "targetFormat",
        "status"
      ],
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "content": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "revision",
        "content"
      ],
      "type": "object"
    },
    "Migration": {
      "additionalProperties": false,
      "properties": {
        "appliedAt": {
          "format": "date-time",
          "type": "string"
        },
        "fromVersion": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        },
        "toolVersion": {
          "minLength": 1,
          "type": "string"
        },
        "toVersion": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "fromVersion",
        "toVersion",
        "appliedAt",
        "tool",
        "toolVersion"
      ],
      "type": "object"
    },
    "OcclusionRegion": {
      "additionalProperties": false,
      "properties": {
        "accessibleDescription": {
          "minLength": 1,
          "type": "string"
        },
        "geometry": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "height": {
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "type": "number"
                },
                "type": {
                  "const": "rectangle"
                },
                "width": {
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "type": "number"
                },
                "x": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "y": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "type",
                "x",
                "y",
                "width",
                "height"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "points": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      },
                      "y": {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": "object"
                  },
                  "minItems": 3,
                  "type": "array"
                },
                "type": {
                  "const": "polygon"
                }
              },
              "required": [
                "type",
                "points"
              ],
              "type": "object"
            }
          ]
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "geometry",
        "accessibleDescription"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "authored",
            "imported",
            "cited",
            "derived",
            "corrected"
          ]
        },
        "license": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "recordedAt": {
          "format": "date-time",
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "recordedAt"
      ],
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "prerequisite",
            "related",
            "derived-from",
            "sibling",
            "duplicate-of"
          ]
        },
        "source": {
          "$ref": "#/$defs/EntityReference"
        },
        "target": {
          "$ref": "#/$defs/EntityReference"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "type": "object"
    },
    "Repetition": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "again",
            "hard",
            "good",
            "easy"
          ]
        },
        "capturedResponse": {
          "type": "string"
        },
        "durationMilliseconds": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "presentationDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "promptId": {
          "minLength": 1,
          "type": "string"
        },
        "promptRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "reviewedAt": {
          "format": "date-time",
          "type": "string"
        },
        "scheduler": {
          "additionalProperties": false,
          "properties": {
            "dueAt": {
              "format": "date-time",
              "type": "string"
            },
            "family": {
              "minLength": 1,
              "type": "string"
            },
            "nextIntervalMinutes": {
              "minimum": 0,
              "type": "integer"
            },
            "parameterDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "previousIntervalMinutes": {
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "family",
            "version"
          ],
          "type": "object"
        },
        "snapshotDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "promptId",
        "promptRevision",
        "reviewedAt",
        "assessment"
      ],
      "type": "object"
    },
    "RepetitionCorrection": {
      "additionalProperties": false,
      "properties": {
        "correctedAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "replacementAssessment": {
          "enum": [
            "again",
            "hard",
            "good",
            "easy"
          ]
        },
        "replacementResponse": {
          "type": "string"
        },
        "targetRepetitionId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "targetRepetitionId",
        "correctedAt",
        "reason"
      ],
      "type": "object"
    },
    "ResponseInteraction": {
      "oneOf": [
        {
          "const": "text"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capture": {
              "const": "none"
            },
            "mode": {
              "const": "self-check"
            }
          },
          "required": [
            "mode",
            "capture"
          ],
          "type": "object"
        }
      ]
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "content": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "content"
      ],
      "type": "object"
    },
    "Prompt": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "challenge": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "clozeTargets": {
          "items": {
            "$ref": "#/$defs/ClozeTarget"
          },
          "minItems": 1,
          "type": "array"
        },
        "extensions": {
          "additionalProperties": false,
          "properties": {
            "optional": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "required": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "basic",
            "cloze",
            "image-occlusion"
          ]
        },
        "materials": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "occlusionRegions": {
          "items": {
            "$ref": "#/$defs/OcclusionRegion"
          },
          "minItems": 1,
          "type": "array"
        },
        "presentationProfile": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "resolution": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "response": {
          "$ref": "#/$defs/ResponseInteraction"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "sourceAsset": {
          "minLength": 1,
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "suspended",
            "retired"
          ]
        },
        "withheld": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "revision",
        "kind",
        "challenge",
        "withheld",
        "resolution",
        "response"
      ],
      "type": "object"
    }
  },
  "$id": "https://lineage.dev/schema/lineage-corpus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "type": "array"
    },
    "corpusId": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "items": {
        "$ref": "#/$defs/Extension"
      },
      "type": "array"
    },
    "format": {
      "const": "lineage.corpus"
    },
    "formatVersion": {
      "const": 1
    },
    "interoperability": {
      "items": {
        "$ref": "#/$defs/InteroperabilityReport"
      },
      "type": "array"
    },
    "materials": {
      "items": {
        "$ref": "#/$defs/Material"
      },
      "type": "array"
    },
    "migrations": {
      "items": {
        "$ref": "#/$defs/Migration"
      },
      "type": "array"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/Prompt"
      },
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "type": "array"
    },
    "repetitionCorrections": {
      "items": {
        "$ref": "#/$defs/RepetitionCorrection"
      },
      "type": "array"
    },
    "repetitions": {
      "items": {
        "$ref": "#/$defs/Repetition"
      },
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "corpusId",
    "prompts"
  ],
  "type": "object",
  "title": "Lineage corpus version 1"
}

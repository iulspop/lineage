{
  "$id": "https://lineage.dev/schema/lineage-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpus": {
      "const": "corpus.json"
    },
    "corpusId": {
      "minLength": 1,
      "type": "string"
    },
    "corpusSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "byteSize": {
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "mediaType",
          "byteSize",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "extensions": {
      "additionalProperties": false,
      "properties": {
        "optional": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "required": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "format": {
      "const": "lineage.manifest"
    },
    "formatVersion": {
      "const": 1
    },
    "modifiedAt": {
      "format": "date-time",
      "type": "string"
    },
    "presentationProfiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "corpusId",
    "corpus",
    "corpusSha256",
    "createdAt",
    "modifiedAt",
    "entries"
  ],
  "type": "object",
  "title": "Lineage archive manifest version 1"
}

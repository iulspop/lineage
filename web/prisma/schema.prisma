generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                            String                         @id @default(cuid())
  email                         String                         @unique
  emailVerifiedAt               DateTime?
  lastSeenAt                    DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  activeLineageCorpusId         String?
  connections                   Connection[]
  passkeys                      Passkey[]
  sessions                      Session[]
  ownerClaim                    OwnerClaim?
  ownedConversations            ChatConversation[]             @relation("ConversationOwner")
  chatConversation              ChatConversation?              @relation("ConversationUser")
  sentChatMessages              ChatMessage[]                  @relation("MessageSender")
  receivedNotifications         ChatNotification[]             @relation("NotificationRecipient")
  chatTypingStates              ChatTypingState[]
  lineageCorpusSnapshots        LineageCorpusSnapshot[]
  lineageReviews                LineageReview[]
  lineageAssets                 LineageCorpusAsset[]
  integrationClients            IntegrationClient[]            @relation("IntegrationClientCreator")
  integrationGrants             IntegrationGrant[]
  integrationIdempotencyRecords IntegrationIdempotencyRecord[]
  integrationAudits             IntegrationCreationAudit[]
}

model LineageCorpusSnapshot {
  id            Int      @id @default(autoincrement())
  ownerId       String?
  corpusId      String
  formatVersion Int
  canonicalJson String
  digest        String
  createdAt     DateTime @default(now())
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, corpusId, digest])
  @@index([ownerId, corpusId, createdAt])
}

model LineageAssetBlob {
  sha256    String               @id
  bytes     Bytes
  byteSize  Int
  mediaType String
  createdAt DateTime             @default(now())
  corpora   LineageCorpusAsset[]
}

model LineageCorpusAsset {
  id                       Int              @id @default(autoincrement())
  ownerId                  String
  corpusId                 String
  assetId                  String
  archivePath              String
  accessibilityDescription String?
  blobSha256               String
  createdAt                DateTime         @default(now())
  owner                    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blob                     LineageAssetBlob @relation(fields: [blobSha256], references: [sha256], onDelete: Restrict)

  @@unique([ownerId, corpusId, assetId])
  @@index([ownerId, corpusId])
  @@index([blobSha256])
}

model LineageReview {
  id                      Int       @id @default(autoincrement())
  userId                  String
  corpusId                String
  promptId                String
  promptRevision          Int
  attemptedResponse       String?
  assessment              String
  scheduler               String
  schedulerVersion        String
  schedulerImplementation String?
  schedulerProfile        String?
  parameterSet            String?
  previousIntervalMinutes Int
  nextIntervalMinutes     Int
  fsrsDueAt               DateTime?
  fsrsStability           Float?
  fsrsDifficulty          Float?
  fsrsElapsedDays         Float?
  fsrsScheduledDays       Int?
  fsrsLearningSteps       Int?
  fsrsReps                Int?
  fsrsLapses              Int?
  fsrsState               Int?
  reviewedAt              DateTime  @default(now())
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([corpusId, promptId, promptRevision])
  @@index([userId, corpusId, fsrsDueAt])
}

model IntegrationClient {
  id                 String                          @id @default(cuid())
  clientId           String                          @unique
  name               String
  clientType         String
  clientSecretHash   String?
  createdByUserId    String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  disabledAt         DateTime?
  createdBy          User?                           @relation("IntegrationClientCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  redirectUris       IntegrationRedirectUri[]
  grants             IntegrationGrant[]
  authorizationCodes IntegrationAuthorizationCode[]
  accessTokens       IntegrationAccessToken[]
  refreshFamilies    IntegrationRefreshTokenFamily[]
  idempotencyRecords IntegrationIdempotencyRecord[]
  creationAudits     IntegrationCreationAudit[]

  @@index([createdByUserId])
}

model IntegrationRedirectUri {
  id        String            @id @default(cuid())
  clientId  String
  uri       String
  createdAt DateTime          @default(now())
  client    IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, uri])
  @@index([clientId])
}

model IntegrationGrant {
  id                 String                          @id @default(cuid())
  userId             String
  clientId           String
  scope              String
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client             IntegrationClient               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorizationCodes IntegrationAuthorizationCode[]
  accessTokens       IntegrationAccessToken[]
  refreshFamilies    IntegrationRefreshTokenFamily[]
  idempotencyRecords IntegrationIdempotencyRecord[]
  creationAudits     IntegrationCreationAudit[]

  @@unique([userId, clientId, scope])
  @@index([clientId, revokedAt])
  @@index([userId, revokedAt])
}

model IntegrationAuthorizationCode {
  id            String            @id @default(cuid())
  codeHash      String            @unique
  clientId      String
  grantId       String
  redirectUri   String
  scope         String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime          @default(now())
  client        IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grant         IntegrationGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([grantId, expiresAt])
}

model IntegrationAccessToken {
  id                 String            @id @default(cuid())
  tokenHash          String            @unique
  clientId           String
  grantId            String
  scope              String
  expiresAt          DateTime
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  windowStartedAt    DateTime?
  windowRequestCount Int               @default(0)
  createdAt          DateTime          @default(now())
  client             IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grant              IntegrationGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([grantId, revokedAt, expiresAt])
}

model IntegrationRefreshTokenFamily {
  id        String                    @id @default(cuid())
  clientId  String
  grantId   String
  revokedAt DateTime?
  createdAt DateTime                  @default(now())
  client    IntegrationClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grant     IntegrationGrant          @relation(fields: [grantId], references: [id], onDelete: Cascade)
  tokens    IntegrationRefreshToken[]

  @@index([clientId, revokedAt])
  @@index([grantId, revokedAt])
}

model IntegrationRefreshToken {
  id           String                        @id @default(cuid())
  familyId     String
  tokenHash    String                        @unique
  expiresAt    DateTime
  usedAt       DateTime?
  replacedById String?
  createdAt    DateTime                      @default(now())
  family       IntegrationRefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, expiresAt])
}

model IntegrationIdempotencyRecord {
  id           String            @id @default(cuid())
  clientId     String
  grantId      String
  userId       String
  key          String
  requestHash  String
  statusCode   Int
  responseJson String
  createdAt    DateTime          @default(now())
  expiresAt    DateTime
  client       IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grant        IntegrationGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId, key])
  @@index([grantId, createdAt])
  @@index([expiresAt])
}

model IntegrationCreationAudit {
  id                 String            @id @default(cuid())
  requestId          String            @unique
  clientId           String
  grantId            String
  userId             String
  corpusId           String?
  priorDigest        String?
  newDigest          String?
  itemCount          Int
  createdPromptCount Int
  outcome            String
  createdAt          DateTime          @default(now())
  client             IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grant              IntegrationGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([grantId, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  expirationDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id        String   @id @default(cuid())
  type      String
  target    String
  secret    String
  algorithm String
  digits    Int
  period    Int
  charSet   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([type, target])
}

model Connection {
  id           String   @id @default(cuid())
  providerName String
  providerId   String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerName, providerId])
  @@index([userId])
}

model Passkey {
  id                   String   @id @default(cuid())
  credentialId         String   @unique
  credentialPublicKey  String
  counter              Int
  transports           String
  credentialDeviceType String
  credentialBackedUp   Boolean
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OwnerClaim {
  singletonKey Int      @id @default(1)
  userId       String   @unique
  claimedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id           String            @id @default(cuid())
  userId       String            @unique
  ownerId      String
  userReadAt   DateTime?
  ownerReadAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  owner        User              @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  messages     ChatMessage[]
  typingStates ChatTypingState[]

  @@index([ownerId, updatedAt])
}

model ChatTypingState {
  conversationId String
  userId         String
  expiresAt      DateTime
  updatedAt      DateTime         @updatedAt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model ChatMessage {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  body           String             @default("")
  createdAt      DateTime           @default(now())
  conversation   ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachments    ChatAttachment[]
  notifications  ChatNotification[]

  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model ChatAttachment {
  id           String      @id @default(cuid())
  messageId    String
  storageName  String      @unique
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime    @default(now())
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatNotification {
  id          String      @id @default(cuid())
  messageId   String
  recipientId String
  channel     String
  status      String
  attemptedAt DateTime    @default(now())
  errorCode   String?
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient   User        @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId, channel])
  @@index([recipientId, attemptedAt])
}
